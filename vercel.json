{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "nodeVersion": "20.x",
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://lumik-shop-omega.vercel.app"
  },
  "routes": [
    {
      "src": "/clones/(.*)",
      "dest": "/clones/$1",
      "methods": ["GET"]
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/clones/:path*",
      "destination": "/:path*"
    }
  ]
}
